<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.reija</groupId>
    <artifactId>java-deser-gadget-finder</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>java-deser-gadget-finder</name>
    <description>
        Análisis estático de bytecode Java que construye un grafo de llamadas
        a partir de un JAR/classpath y busca automáticamente cadenas de gadgets
        de deserialización explotables, sin depender de payloads fijos
        para librerías conocidas.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <asm.version>9.7</asm.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- ASM: framework de análisis y manipulación de bytecode JVM.
             Es la librería que usa el propio ecosistema Java (Spring, Hibernate,
             Gradle...) para este tipo de trabajo; por eso se eligió frente a
             alternativas más ligeras como javap parseado por texto, que no da
             acceso estructurado al bytecode real. -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-util</artifactId>
            <version>${asm.version}</version>
        </dependency>

        <!-- JCommander: parseo de argumentos CLI, ligero y sin dependencias transitivas -->
        <dependency>
            <groupId>com.beust</groupId>
            <artifactId>jcommander</artifactId>
            <version>1.82</version>
        </dependency>

        <!-- JUnit 5 para tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gadget-finder</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- shade plugin: empaqueta todas las dependencias en un único JAR
                 ejecutable, para que el usuario final solo tenga que hacer
                 `java -jar gadget-finder.jar` sin gestionar classpath aparte -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.reija.gadgetfinder.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
